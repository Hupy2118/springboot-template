{
  "name": "@za38.03/devagentstudio-lowcode-template-maintenance",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "dev:base": "node assembly/dev.mjs --profile=base",
    "dev:login": "node assembly/dev.mjs --profile=login",
    "dev:authorization": "node assembly/dev.mjs --profile=authorization",
    "dev:full": "node assembly/dev.mjs --profile=full",
    "build:base": "node assembly/build-profile.mjs --profile=base",
    "build:login": "node assembly/build-profile.mjs --profile=login",
    "build:authorization": "node assembly/build-profile.mjs --profile=authorization",
    "build:full": "node assembly/build-profile.mjs --profile=full",
    "assemble": "node assembly/assemble.mjs",
    "status:workspace": "node assembly/workspace-status.mjs",
    "sync:base": "node assembly/workspace-sync.mjs --profile=base",
    "sync:login": "node assembly/workspace-sync.mjs --profile=login",
    "sync:authorization": "node assembly/workspace-sync.mjs --profile=authorization",
    "materialize:base": "node assembly/reset-workspace.mjs --profile=base",
    "materialize:full": "node assembly/reset-workspace.mjs --profile=full",
    "reset:base": "node assembly/reset-workspace.mjs --profile=base",
    "reset:login": "node assembly/reset-workspace.mjs --profile=login",
    "reset:authorization": "node assembly/reset-workspace.mjs --profile=authorization",
    "reset:full": "node assembly/reset-workspace.mjs --profile=full",
    "verify:assembly": "node assembly/verify-generated.mjs",
    "verify:release": "node assembly/verify-release.mjs",
    "test:assembly": "node assembly/test-assemble.mjs",
    "test:workspace-sync": "node assembly/test-workspace-sync.mjs",
    "verify:update:base": "pnpm build:base && pnpm build:login && pnpm build:authorization && pnpm build:full",
    "verify:update:login": "pnpm build:login && pnpm build:authorization && pnpm build:full",
    "verify:update:authorization": "pnpm build:authorization && pnpm build:full"
  }
}
