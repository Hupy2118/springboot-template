<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cmbchina.managedb.infrastructure.persistence.mapper.TableBindingMapper">
    <resultMap id="BaseResultMap" type="com.cmbchina.managedb.infrastructure.persistence.po.TableBindingPo">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="datasource_key" property="datasourceKey" jdbcType="VARCHAR"/>
        <result column="datasource_id" property="datasourceId" jdbcType="TINYINT"/>
        <result column="table_name" property="tableName" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="VARCHAR"/>
        <result column="created_by" property="createdBy" jdbcType="VARCHAR"/>
        <result column="creator" property="creator" jdbcType="VARCHAR"/>
        <result column="is_deleted" property="deleted" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id
        , datasource_key, datasource_id, table_name, status, created_by, creator, is_deleted
    </sql>

    <insert id="insert" parameterType="com.cmbchina.managedb.infrastructure.persistence.po.TableBindingPo">
        INSERT INTO md_datasource_table
        (id, datasource_key, datasource_id, table_name, status, created_by, creator, is_deleted)
        VALUES (#{id}, #{datasourceKey}, #{datasourceId}, #{tableName}, #{status}, #{createdBy}, #{creator}, #{deleted})
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM md_datasource_table
        WHERE id = #{id}
    </select>

    <select id="selectByDatasourceKey" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM md_datasource_table
        WHERE datasource_key = #{datasourceKey}
    </select>

    <select id="selectActiveByDatasourceKey" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM md_datasource_table
        WHERE datasource_key = #{datasourceKey}
        AND is_deleted = 0
    </select>

    <select id="selectByDatasourceIdAndTableName" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM md_datasource_table
        WHERE datasource_id = #{datasourceId}
        AND table_name = #{tableName}
    </select>

    <update id="updateStatusById">
        UPDATE md_datasource_table
        SET status = #{status}
        WHERE id = #{id}
    </update>

    <select id="lock" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM md_datasource_table
        WHERE datasource_id = #{datasourceId}
        AND table_name = #{tableName}
        FOR UPDATE
    </select>
</mapper>
