<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.devagentstudio.template</groupId>
        <artifactId>template-engine</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <groupId>com.cmbchina</groupId>
    <artifactId>managed-database-core</artifactId>
    <name>managed-database-core</name>
    <description>DevAgent Studio 数据库资源服务核心模块（library，由 engine-service 统一启动）</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>local-mock</id>
            <dependencies>
                <dependency>
                    <groupId>com.devagentstudio.template</groupId>
                    <artifactId>bee-compat</artifactId>
                    <version>${project.version}</version>
                </dependency>
                <dependency>
                    <groupId>com.mysql</groupId>
                    <artifactId>mysql-connector-j</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>managed-enterprise</id>
            <dependencyManagement>
                <dependencies>
                    <dependency>
                        <groupId>ZA21</groupId>
                        <artifactId>bee-starter-parent</artifactId>
                        <version>6.0.7</version>
                        <type>pom</type>
                        <scope>import</scope>
                    </dependency>
                </dependencies>
            </dependencyManagement>
            <dependencies>
                <dependency>
                    <groupId>ZA21</groupId>
                    <artifactId>bee-starter-logging</artifactId>
                </dependency>
                <dependency>
                    <groupId>ZA21</groupId>
                    <artifactId>bee-starter-tracer</artifactId>
                </dependency>
                <dependency>
                    <groupId>ZA21</groupId>
                    <artifactId>bee-starter-metrics</artifactId>
                </dependency>
                <dependency>
                    <groupId>ZA21</groupId>
                    <artifactId>bee-starter-healthcheck</artifactId>
                </dependency>
                <dependency>
                    <groupId>ZA21</groupId>
                    <artifactId>bee-starter-web</artifactId>
                </dependency>
                <dependency>
                    <groupId>ZA21</groupId>
                    <artifactId>bee-starter-id</artifactId>
                </dependency>
                <dependency>
                    <groupId>ZA21</groupId>
                    <artifactId>bee-starter-microservice</artifactId>
                </dependency>
                <dependency>
                    <groupId>LT99.09</groupId>
                    <artifactId>tdsql-mysql-connector-java8</artifactId>
                    <version>1.5.0</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <version>3.15.0</version>
                        <configuration>
                            <!-- These controller contract tests exercise the local Bee implementation. -->
                            <testExcludes>
                                <testExclude>**/DataOperationControllerTest.java</testExclude>
                                <testExclude>**/DatasourceRegistrationControllerTest.java</testExclude>
                                <testExclude>**/DatasourceRuntimeConnectionControllerTest.java</testExclude>
                                <testExclude>**/DatasourceTableMetadataControllerTest.java</testExclude>
                                <testExclude>**/TableOperationRecoveryControllerTest.java</testExclude>
                                <testExclude>**/TableSynchronizationControllerTest.java</testExclude>
                            </testExcludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
