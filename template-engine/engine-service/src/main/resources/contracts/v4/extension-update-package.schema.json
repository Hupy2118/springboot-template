{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devagentstudio.local/template-engine/v4/extension-update-package.schema.json",
  "title": "ExtensionUpdatePackageV4",
  "type": "object",
  "required": [
    "protocolVersion",
    "packageId",
    "mode",
    "sourceRevision",
    "operations",
    "validationPlan",
    "payloadManifest",
    "nextTemplateState",
    "diagnostics",
    "expectedStateSequence"
  ],
  "properties": {
    "protocolVersion": {
      "const": "4"
    },
    "packageId": {
      "type": "string",
      "pattern": "^pkg-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "mode": {
      "enum": [
        "APPLY",
        "RECONCILE"
      ]
    },
    "sourceRevision": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*$"
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "operation.schema.json"
      }
    },
    "validationPlan": {
      "type": "array",
      "maxItems": 0
    },
    "payloadManifest": {
      "type": "object",
      "patternProperties": {
        "^payload/.+$": {
          "$ref": "#/$defs/payloadMetadata"
        }
      },
      "additionalProperties": false
    },
    "nextTemplateState": {
      "$ref": "template-state.schema.json"
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 0
    },
    "expectedStateSequence": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "$defs": {
    "payloadMetadata": {
      "type": "object",
      "required": [
        "size"
      ],
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  }
}
