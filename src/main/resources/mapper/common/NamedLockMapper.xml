<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.cmbchina.backend.common.lock.NamedLockMapper">

    <select id="getLock" parameterType="java.lang.String" resultType="java.lang.Integer">
        SELECT GET_LOCK(#{lockName}, 5)
    </select>

    <select id="releaseLock" parameterType="java.lang.String" resultType="java.lang.Integer">
        SELECT RELEASE_LOCK(#{lockName})
    </select>
</mapper>
